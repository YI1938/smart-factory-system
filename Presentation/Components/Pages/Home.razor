@page "/"
@using SmartFactorySystem.Application.Models
@using SmartFactorySystem.Application.Services
@inject MachineService MachineService

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">🏭 工場全体サマリー</h2>
        <div class="text-muted">最終更新: @DateTime.Now.ToString("yyyy/MM/dd HH:mm:ss")</div>
    </div>

    @if (machines == null)
    {
        <div class="text-center mt-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white shadow-sm border-0">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase opacity-75">総設備数</h6>
                        <h2 class="fw-bold">@machines.Count</h2>
                        <i class="bi bi-cpu position-absolute top-50 end-0 translate-middle-y me-3 opacity-25" style="font-size: 2.5rem;"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white shadow-sm border-0">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase opacity-75">稼働中</h6>
                        <h2 class="fw-bold">@machines.Count(m => m.Status == "Running")</h2>
                        <i class="bi bi-play-circle position-absolute top-50 end-0 translate-middle-y me-3 opacity-25" style="font-size: 2.5rem;"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-danger text-white shadow-sm border-0">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase opacity-75">異常停止</h6>
                        <h2 class="fw-bold">@machines.Count(m => m.Status == "Error")</h2>
                        <i class="bi bi-exclamation-triangle position-absolute top-50 end-0 translate-middle-y me-3 opacity-25" style="font-size: 2.5rem;"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white shadow-sm border-0">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase opacity-75">全体平均進捗</h6>
                        <h2 class="fw-bold">@((machines.Average(m => m.ProgressRate)).ToString("0.0"))%</h2>
                        <i class="bi bi-graph-up-arrow position-absolute top-50 end-0 translate-middle-y me-3 opacity-25" style="font-size: 2.5rem;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-7">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white fw-bold"><i class="bi bi-bell-fill text-danger"></i> 要対応アラート</div>
                    <div class="card-body">
                        @if (!machines.Any(m => m.Status == "Error"))
                        {
                            <p class="text-success text-center my-4">現在、全ての設備が正常に稼働・管理されています。</p>
                        }
                        else
                        {
                            @foreach (var m in machines.Where(m => m.Status == "Error"))
                            {
                                <div class="alert alert-danger d-flex justify-content-between align-items-center mb-2 shadow-sm">
                                    <div>
                                        <strong>@m.MachineName</strong>: @m.StopReason
                                    </div>
                                    <a href="machines" class="btn btn-sm btn-danger">詳細</a>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white fw-bold"><i class="bi bi-info-circle text-primary"></i> システム通知</div>
                    <div class="card-body">
                        <ul class="list-unstyled small">
                            <li class="mb-2">🔹 【完了】DBマイグレーションと三層アーキテクチャの同期が成功しました。</li>
                            <li class="mb-2">🔹 【開発】Entity Framework Coreによるデータ永続化層の構築が完了しました。</li>
                            <li class="mb-2">🔹 【次期】Azure IoT Hubとの連携によるリアルタイムデータ収集機能を検討中。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<MachineStatus>? machines;

    protected override async Task OnInitializedAsync()
    {
        machines = await MachineService.GetMachinesAsync();
    }
}