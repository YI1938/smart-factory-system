@page "/machines"

@using SmartFactorySystem.Application.Models
@using SmartFactorySystem.Application.Services

@inject MachineService MachineService

<h3>生産ライン稼働状況</h3>

@if (machines == null)
{
    <p>読み込み中...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>設備ID</th>
                <th>設備名</th>
                <th>状態</th>
                <th>最終更新</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var machine in machines)
            {
                <tr>
                    <td>@machine.MachineId</td>
                    <td>@machine.MachineName</td>
                    <td>
                        @switch(machine.Status)
                        {
                            case "Running":
                                <span class="badge bg-success">稼働中</span>
                                break;
                            case "Stopped":
                                <span class="badge bg-secondary">停止</span>
                                break;
                            case "Error":
                                <span class="badge bg-danger">異常</span>
                                break;
                        }
                    </td>
                    <td>@machine.LastUpdated.ToLocalTime()</td>
                    <td>
                        <button class="btn btn-success btn-sm me-1"
                                @onclick='() => UpdateStatus(machine.Id, "Running")'>
                            稼働
                        </button>
                        <button class="btn btn-warning btn-sm me-1"
                                @onclick='() => UpdateStatus(machine.Id, "Stopped")'>
                            停止
                        </button>
                        <button class="btn btn-danger btn-sm"
                                @onclick='() => UpdateStatus(machine.Id, "Error")'>
                            異常
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<MachineStatus>? machines;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        machines = await MachineService.GetMachinesAsync();
    }

    private async Task UpdateStatus(int id, string status)
    {
        await MachineService.UpdateMachineStatusAsync(id, status);
        await LoadData();
    }
}