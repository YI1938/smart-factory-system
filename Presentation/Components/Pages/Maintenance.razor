@page "/maintenance"
@using Microsoft.ApplicationInsights
@using Microsoft.ApplicationInsights.DataContracts
@inject TelemetryClient TelemetryClient

<h3 class="fw-bold">🛠 保全・エラー履歴（監視稼働中）</h3>
<div class="alert alert-info shadow-sm">
    <i class="bi bi-shield-check"></i> 現在、Application Insightsによるリアルタイム監視が有効です。異常検知データは自動的にAzureへ転送されます。
</div>

<div class="card shadow-sm mt-4">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead class="table-light">
                <tr>
                    <th>発生日時</th>
                    <th>設備名</th>
                    <th>エラー内容</th>
                    <th>対応状況</th>
                </tr>
            </thead>
            <tbody>
                @* 本来はDBから取得しますが、今回はシミュレーションとして1行表示 *@
                <tr>
                    <td>2026-06-02 10:00</td>
                    <td>CNC-Router-01</td>
                    <td>冷却ファン回転数異常</td>
                    <td><span class="badge bg-danger">未対応</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        // 画面が読み込まれた際、シミュレーションとして「異常検知イベント」を送信
        var properties = new Dictionary<string, string> 
        { 
            { "MachineId", "CNC-01" },
            { "ErrorType", "CoolingFanFailure" },
            { "Location", "Nagoya-Plant-Line1" },
            { "ISA95_Level", "Level 2 (Sensing)" }
        };

        // Azure Application Insightsにカスタムイベントを飛ばす
        TelemetryClient.TrackEvent("MachineMaintenanceRequired", properties);
        
        // ログとしても詳細を残す
        TelemetryClient.TrackTrace("Maintenance page accessed: Monitoring event triggered.", SeverityLevel.Information);

        // ※本来はここで DB からエラー履歴を取得するロジックが入ります
    }
}